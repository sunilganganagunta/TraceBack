# -----------------------------------------------------------------------------
# TraceBack Environment Configuration Template
# Copy this file to .env and adjust variables as required for your environment.
# -----------------------------------------------------------------------------

# Database Configuration (MongoDB)
# For local MongoDB: mongodb://localhost:27017/traceback
# For Docker Compose: mongodb://mongo:27017/traceback
# For MongoDB Atlas: mongodb+srv://<username>:<password>@cluster0.xxxx.mongodb.net/traceback?retryWrites=true&w=majority
SPRING_DATA_MONGODB_URI=mongodb://localhost:27017/traceback
SPRING_DATA_MONGODB_DATABASE=traceback

# Authentication Secrets
# Secure 256-bit secret key used to sign and verify HMAC-SHA256 JWT tokens
JWT_SECRET=TraceBackSecretKeyForJwtAuthenticationMustBeAtLeast256BitsLongForHS256Security
# Expiration in milliseconds (86400000 ms = 24 hours)
JWT_ACCESS_TOKEN_EXPIRATION=86400000

# Networking & CORS
FRONTEND_ORIGIN=http://localhost:5173,http://localhost:3000
BACKEND_PORT=8080

# Storage & Uploads
UPLOAD_PROVIDER=local
UPLOAD_DIRECTORY=uploads
MAX_UPLOAD_SIZE_MB=5

# Mail Notifications (Optional - in-app notification system works without external SMTP)
MAIL_ENABLED=false
MAIL_HOST=
MAIL_USERNAME=
MAIL_PASSWORD=

# Demo Data Seeder (true creates initial categories, test accounts, and sample matching reports)
SEED_DATA_ENABLED=true
